# =========================================================================
# תבנית להגדרות הבקאנד.
#
# על השרת:   cp .env.example .env    ואז למלא את הערכים האמיתיים.
# הקובץ .env עצמו לא נכנס ל-git — כל שרת מחזיק משלו.
#
# הערכים כאן הם סודות אמיתיים (בניגוד לאדמין) — הם רצים בצד השרת
# ולעולם לא מגיעים לדפדפן.
# =========================================================================

# ---- שרת ----
PORT=3047
# אופציונלי. 127.0.0.1 אם השרת יושב מאחורי reverse proxy באותה מכונה.
# אין להשתמש ב-HOST — זה משתנה שמשמש למייל וישבור את ה-listen.
SERVER_BIND_HOST=

# ---- מסד נתונים ----
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# ---- אבטחה ----
# מחרוזות אקראיות ארוכות. ליצירה: openssl rand -base64 48
JWT_SECRET=
JWT_SECRET_FOR_VERIFY=
# סיסמה לעדכון סטטוס הזמנה מגורם חיצוני
UPDATE_ORDER_PASSWORD=

# ---- כתובות ציבוריות ----
# ⚠ בלי "/" בסוף — הקוד משרשר "/success", "/user/..." וכו'
STORE_URL=https://example.com
ADMIN_URL=https://example.com/sweet-admin
# כתובת ציבורית של הבקאנד. ה-webhook של Cardcom חייב להגיע מבחוץ.
API_BASE_URL=https://example.com/sweet-backend/api

COMPANY_NAME=

# ---- מייל ----
SERVICE=gmail
HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
# סיסמת אפליקציה של גוגל — 16 תווים בדיוק
EMAIL_PASS=
STANDARD_EMAIL_PASS=
OUR_EMAIL=
# מופרד בפסיקים
ADMINS_EMAILS=
UNDELIVERABLE_REPORT_EMAIL=

# ---- קליטת הזמנות ממייל ----
MAIL_POLLING_ENABLED=false
SURVEY_DAYS_BACK=30
# המנוע הפנימי הוא הראשי; ה-AI החיצוני כבוי
INGESTION_USE_EXTERNAL_AI=false
# מוצר מוסתר כן ניתן להזמנה
INGESTION_ALLOW_HIDDEN_PRODUCTS=true
# בלי אימות עיר, דמי משלוח 0, בלי מינימום
INGESTION_IGNORE_DELIVERY_TARGETS=true

OPENAI_API_KEY=

# ---- סליקה (Cardcom) ----
CARDCOM_KEY=
CARDCOM_SECRET=
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=

# ---- אחסון קבצים ----
UPLOADS_FOLDER=uploads

# ---- Amazon S3 (אופציונלי) ----
BUCKET=
AMAZON_USERNAME=
AMAZON_PASS=
AMAZON_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ARN=

# ---- Google OAuth (התחברות עם גוגל בחנות) ----
CLIENT_ID=
CLIENT_SECRET=

# ---- וואטסאפ ----
KIRSHNER_WHATSAPP_URL=
